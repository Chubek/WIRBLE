 ; Loop unrolling in trace
 trace @unrolled_loop {
   version: 1
   unroll_factor: 4
   
   block_loop:
     ; Iteration 0
     %0 = load i32, ptr %arr[%i]
     %1 = add i32 %0, 1
     store i32 %1, ptr %arr[%i]
     
     ; Iteration 1
     %2 = load i32, ptr %arr[%i+1]
     %3 = add i32 %2, 1
     store i32 %3, ptr %arr[%i+1]
     
     ; Iteration 2
     %4 = load i32, ptr %arr[%i+2]
     %5 = add i32 %4, 1
     store i32 %5, ptr %arr[%i+2]
     
     ; Iteration 3
     %6 = load i32, ptr %arr[%i+3]
     %7 = add i32 %6, 1
     store i32 %7, ptr %arr[%i+3]
     
     %next_i = add i32 %i, 4
     guard_range %next_i, 0, %len, deopt
     br block_loop
 }
