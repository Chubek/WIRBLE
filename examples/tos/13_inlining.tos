 ; Trace-based inlining
 trace @with_inlined_call {
   version: 1
   
   block_0:
     %x = load i32, ptr %x_ptr
     
     ; Inlined call to @helper
     ; Original: %result = call @helper(i32 %x)
     %doubled = mul i32 %x, 2
     %incremented = add i32 %doubled, 1
     ; End inline
     
     store i32 %incremented, ptr %result_ptr
     ret void
   
   inline_metadata {
     inlined_function: @helper
     inline_cost: 2
     call_site: block_0 + 4
   }
 }
