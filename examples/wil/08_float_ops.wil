 ; Floating-point operations
 graph @float_calc {
   n0 = start : control
   n1 = param 0 : f32 "x"
   n2 = param 1 : f32 "y"
   n3 = add : f32 <- data:n1 data:n2
   n4 = mul : f32 <- data:n3 data:n1
   n5 = div : f32 <- data:n4 data:n2
   n6 = neg : f32 <- data:n5
   n7 = abs : f32 <- data:n6
   n8 = return : control <- control:n0 data:n7
 }
