 ; Graph with dead code
 graph @dead_code {
   n0 = start : control
   n1 = param 0 : i32 "x"
   n2 = const_int 10 : i32
   n3 = add : i32 <- data:n1 data:n2
   n4 = mul : i32 <- data:n3 data:n2
   n5 = sub : i32 <- data:n4 data:n1
   n6 = add : i32 <- data:n1 data:n2
   n7 = return : control <- control:n0 data:n6
 }
