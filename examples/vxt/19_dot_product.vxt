     instruction: "vdpps"
     immediate_mask: true
     result_lanes: 1
     latency: 11
   }
   
   operation dp_int {
     semantic: "dot_product"
     element_type: "i16"
     lanes: 8
     instruction: "vpmaddwd"
     result_type: "i32"
     result_lanes: 4
     latency: 5
   }
 }
