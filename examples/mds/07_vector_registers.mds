 ; Vector register file
 machine x86_avx {
   target: x86_64
   
   register_class vector {
     registers: [xmm0, xmm1, xmm2, xmm3, xmm4, xmm5, xmm6, xmm7]
     width: 128
   }
   
   register_class vector_wide {
     registers: [ymm0, ymm1, ymm2, ymm3, ymm4, ymm5, ymm6, ymm7]
     width: 256
   }
   
   instruction vaddps {
     mnemonic: "vaddps"
     operands: [$dst:vector_wide, $src1:vector_wide, $src2:vector_wide]
     encoding: "VEX.256.0F.WIG 58 /r"
     cost: 3
     latency: 4
   }
 }
